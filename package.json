{
  "name": "semantic-color-system-generator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite --host 127.0.0.1",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --host 127.0.0.1",
    "verify:pwa": "node scripts/verify-pwa-build.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "culori": "^4.0.2",
    "postcss": "^8.5.6",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@terrazzo/parser": "^2.4.0",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.3.0",
    "happy-dom": "^21.0.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4",
    "workbox-window": "^7.4.1"
  }
}
